# dependencies
node_modules/

# build outputs
dist/
out/

# electron-builder artefacts — allow the Windows installer in release/
release/*
*.dmg
*.AppImage
*.snap
*.deb
*.rpm

# environment / secrets
.env
.env.*
*.local

