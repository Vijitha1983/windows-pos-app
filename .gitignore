serials-pack-*.csv

# editor
.vscode/
.idea/
*.suo
*.user

# OS
.DS_Store
Thumbs.db

# electron-store persisted data (contains session cookies — never commit)
app-data/

# update packages (built artefacts — don't commit)
updates/
